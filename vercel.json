{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/menu.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/admin.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/^/api/(.*)$",
      "dest": "/api/server.js"
    },
    {
      "src": "/menu.html",
      "dest": "/public/menu.html"
    },
    {
      "src": "/admin.html",
      "dest": "/public/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}